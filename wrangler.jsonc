{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibed-waitlist",
  "account_id": "2c7358a6bfb966e9717922cb59b14ff2",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "vibed-waitlist.xavainf.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "src/worker.ts",
  "observability": {
    "enabled": true
  }
}
